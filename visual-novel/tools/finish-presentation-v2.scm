; GIMP 2.10. Run from repository root. Preserve generation, local repairs and masks.
(define p2-root "visual-novel/art/presentation-v2/")
(define p2-out "visual-novel/renpy/game/art/")
(define (p2-patch im filename name points)
 (let* ((p (string-append p2-root "raw/" filename))
        (layer (car (gimp-file-load-layer RUN-NONINTERACTIVE im p))))
  (gimp-image-insert-layer im layer 0 0)
  (gimp-item-set-name layer name)
  (gimp-image-select-polygon im CHANNEL-OP-REPLACE (vector-length points) points)
  (gimp-selection-feather im 3)
  (gimp-layer-add-mask layer (car (gimp-layer-create-mask layer ADD-SELECTION-MASK)))
  (gimp-selection-none im)
  layer))
(define (p2-export im path)
 (let ((flat (car (gimp-image-merge-visible-layers im CLIP-TO-IMAGE))))
  (file-png-save RUN-NONINTERACTIVE im flat path path 0 9 0 0 0 0 0)
  ))
(define (p2-crop im path x y w h)
 (let ((copy (car (gimp-image-duplicate im))))
  (gimp-image-crop copy w h x y)
  (p2-export copy path)
  (gimp-image-delete copy)))
(let* ((path (string-append p2-root "raw/mothers-chair.png"))
       (im (car (gimp-file-load RUN-NONINTERACTIVE path path)))
       (paper 0) (retouch 0)
       (xcf (string-append p2-root "masters/mothers-chair.xcf")))
 (gimp-item-set-name (car (gimp-image-get-active-layer im)) "00 Original - retained face, hands, room and light")
 (p2-patch im "mothers-chair-repairs.png" "01 Plain modern cotton clothing - local mask"
  #(846 365 919 412 939 459 1043 521 1147 486 1183 403 1191 347 1266 333 1351 388 1412 457 1505 749 1139 739 1109 716 1144 687 1118 657 981 636 903 653 829 679 804 617 752 601 687 609 652 649 674 712 580 685 596 584 638 494 694 435 773 391))
 (set! paper (p2-patch im "mothers-chair-repairs.png" "02 Smooth welcome letter and short pen tear - local mask"
  #(391 705 653 689 679 720 740 728 797 715 867 700 926 713 1005 712 1088 704 1062 861 380 794)))
 ; Only this paper component went through generation again; no face/body input.
 (set! retouch (car (gimp-file-load-layer RUN-NONINTERACTIVE im
  "visual-novel/art/presentation-v2/raw/clean-paper-component.png")))
 (gimp-image-insert-layer im retouch 0 0)
 (gimp-item-set-name retouch "03 Chair-only restart - registered clean-paper component")
 (gimp-layer-scale retouch 192 139 TRUE)
 (gimp-layer-set-offsets retouch 880 711)
 (gimp-image-select-polygon im CHANNEL-OP-REPLACE 10 #(891 723 1037 722 1042 811 891 812 892 766))
 (gimp-selection-feather im 5)
 (gimp-layer-add-mask retouch (car (gimp-layer-create-mask retouch ADD-SELECTION-MASK)))
 (gimp-selection-none im)
 (gimp-xcf-save RUN-NONINTERACTIVE im retouch xcf xcf)
 (p2-export im (string-append p2-out "cg/mothers-chair.png"))
 (p2-crop im (string-append p2-out "cg/detail-drawing.png") 388 690 710 171)
 (p2-crop im (string-append p2-out "cg/detail-phone.png") 1100 742 342 148)
 (p2-crop im "/tmp/vn-mothers-chair-face.png" 844 124 370 354)
 (p2-crop im "/tmp/vn-mothers-chair-hands.png" 616 577 551 164)
 (gimp-image-delete im))
(gimp-quit 0)
