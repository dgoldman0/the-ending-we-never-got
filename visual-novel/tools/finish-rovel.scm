(define (rv-runtime-detail scene name x y w h)
 (for-each (lambda (root)
  (let* ((path (string-append root "cg/" scene ".png"))
         (im (car (gimp-file-load RUN-NONINTERACTIVE path path))))
   (gimp-image-crop im w h x y)
   (rv-export im (string-append root "details/" name ".png"))
   (gimp-image-delete im))) (list rv-out rv-soft)))

