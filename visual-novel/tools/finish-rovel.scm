; Controlled component finishing in GIMP 2.10. No reference recasting.
(define rv-root "visual-novel/art/rovel/")
(define rv-out "visual-novel/renpy/game/art/rovel/")
(define rv-soft "visual-novel/renpy/game/art/softened/rovel/")
(define (rv-export im path)
 (let* ((copy (car (gimp-image-duplicate im)))
        (flat (car (gimp-image-merge-visible-layers copy CLIP-TO-IMAGE))))
  (file-png-save RUN-NONINTERACTIVE copy flat path path 0 9 0 0 0 0 0)
  (gimp-image-delete copy)))
(define (rv-save im name)
 (let ((path (string-append rv-root "masters/" name ".xcf")))
  (gimp-xcf-save RUN-NONINTERACTIVE im (car (gimp-image-get-active-layer im)) path path)))
(define (rv-grade layer mode softened)
 (cond
  ((equal? mode "bright")
   (gimp-hue-saturation layer ALL-HUES 0 0 -12)
   (if softened
    (gimp-curves-spline layer HISTOGRAM-VALUE 10 #(0 0 48 56 110 139 180 215 255 250))
    (gimp-curves-spline layer HISTOGRAM-VALUE 14 #(0 4 35 69 70 146 110 224 155 249 210 254 255 255))))
  ((equal? mode "ordinary")
   (gimp-color-balance layer MIDTONES TRUE -4 0 5)
   (if softened
    (gimp-curves-spline layer HISTOGRAM-VALUE 10 #(0 0 48 45 110 120 180 200 255 248))
    (gimp-curves-spline layer HISTOGRAM-VALUE 12 #(0 0 48 33 96 112 155 208 215 250 255 255))))
  ((equal? mode "night")
   (gimp-color-balance layer MIDTONES TRUE -10 -1 8)
   (gimp-hue-saturation layer ALL-HUES 0 0 -18)
   (if softened
    (gimp-curves-spline layer HISTOGRAM-VALUE 12 #(0 0 48 24 96 57 155 113 215 184 255 236))
    (gimp-curves-spline layer HISTOGRAM-VALUE 12 #(0 0 48 6 96 20 155 52 215 147 255 233))))))
(define (rv-portrait sheet name x y w h variants)
 (let* ((path (string-append rv-root "raw/" sheet ".png"))
        (im (car (gimp-file-load RUN-NONINTERACTIVE path path)))
        (source (car (gimp-image-get-active-layer im))))
  (gimp-image-crop im w h x y)
  (let* ((long-side (max w h))
         (sw (round (* 512 (/ w long-side))))
         (sh (round (* 512 (/ h long-side)))))
   (gimp-image-scale im sw sh)
   (gimp-image-resize im 512 512 (round (/ (- 512 sw) 2)) (round (/ (- 512 sh) 2)))
   (gimp-layer-resize-to-image-size source))
  (gimp-item-set-name source "00 Identity/expression crop - no costume or prop inference")
  ; Remove the neutral sheet around the head rather than lighting a pale oval.
  ; Contiguous corner samples preserve skin and the darker hair silhouette.
  (gimp-context-set-sample-threshold-int 18)
  (gimp-context-set-sample-merged FALSE)
  (gimp-image-select-contiguous-color im CHANNEL-OP-REPLACE source 3 3)
  (gimp-image-select-contiguous-color im CHANNEL-OP-ADD source 507 3)
  (gimp-selection-invert im)
  ; The lower corners of Tessa's sheet contain hair, not background. Never seed
  ; from them. Protect the continuous face/neck interior against tonal overlap.
  (if (equal? sheet "tessa-expressions-v1")
   (begin
    (gimp-image-select-ellipse im CHANNEL-OP-ADD 108 125 287 382)
    ; Hand-traced outside contour excludes sheet left among the lower strands.
    (gimp-image-select-polygon im CHANNEL-OP-INTERSECT 64
     (list->vector (map (lambda (n) (* n (/ 512 627)))
      '(179 27 282 4 419 27 496 65 546 132 548 212 535 269 527 318
        548 363 553 401 597 432 616 477 614 551 589 598 549 618 480 604
        438 585 422 622 236 624 235 575 184 542 149 493 125 448 125 399
        112 364 110 327 115 289 90 249 91 206 99 154 115 96 143 62))))))
  (gimp-selection-feather im 1.4)
  (gimp-layer-add-mask source (car (gimp-layer-create-mask source ADD-SELECTION-MASK)))
  (gimp-selection-none im)
  (gimp-image-select-rectangle im CHANNEL-OP-REPLACE 0 497 512 15)
  (gimp-selection-feather im 10)
  (gimp-context-set-foreground '(0 0 0))
  (gimp-edit-fill (car (gimp-layer-get-mask source)) FOREGROUND-FILL)
  (gimp-selection-none im)
  (for-each
   (lambda (variant)
    (let* ((label (car variant)) (mode (cadr variant))
           (intense (car (gimp-layer-copy source TRUE)))
           (soft (car (gimp-layer-copy source TRUE))))
     (gimp-item-set-visible source FALSE)
     (gimp-image-insert-layer im intense 0 0)
     (gimp-item-set-visible intense TRUE)
     (gimp-item-set-name intense (string-append "Intense " label " - editable scene grade"))
     (rv-grade intense mode #f)
     (rv-export im (string-append rv-out "portraits/" name "-" label ".png"))
     (gimp-item-set-visible intense FALSE)
     (gimp-image-insert-layer im soft 0 0)
     (gimp-item-set-visible soft TRUE)
     (gimp-item-set-name soft (string-append "Softened " label " - from same source"))
     (rv-grade soft mode #t)
     (rv-export im (string-append rv-soft "portraits/" name "-" label ".png"))
     (gimp-item-set-visible soft FALSE))) variants)
  ; The saved visible layers reproduce the delivered default, not an ungraded crop.
  (gimp-item-set-visible (vector-ref (cadr (gimp-image-get-layers im)) 1) TRUE)
  (rv-save im name)
  (gimp-image-delete im)))
(define (rv-interface)
 (let* ((path (string-append rv-root "raw/reading-surface-v1.png"))
        (im (car (gimp-file-load RUN-NONINTERACTIVE path path)))
        (source (car (gimp-image-get-active-layer im)))
        (clean (car (gimp-layer-copy source TRUE))))
  (gimp-item-set-name source "00 Unmodified generated complete frame")
  (gimp-item-set-visible source FALSE)
  (gimp-image-insert-layer im clean 0 0)
  (gimp-item-set-name clean "01 Remove stray alpha; preserve all four crafted edges")
  (gimp-levels clean HISTOGRAM-ALPHA 24 250 1.0 0 255)
  (gimp-image-crop im 2116 579 29 62)
  (gimp-image-scale im 1600 438)
  (rv-save im "reading-surface")
  (rv-export im (string-append rv-out "ui/reading-surface.png"))
  ; Smaller prose/menu panels need an open text field. Keep the complete border
  ; and corners, and replace the large interior branch using the panel's texture.
  (let ((quiet (car (gimp-layer-copy clean TRUE))))
   (gimp-image-insert-layer im quiet 0 0)
   (gimp-item-set-name quiet "02 Quiet-panel texture repair, complete border retained")
   (gimp-image-select-rectangle im CHANNEL-OP-REPLACE 450 55 240 347)
   (gimp-edit-copy quiet)
   (gimp-selection-none im)
   (let ((patch (car (gimp-edit-paste quiet FALSE))))
    (gimp-layer-set-offsets patch 22 55)
    (gimp-floating-sel-anchor patch))
   (rv-export im (string-append rv-out "ui/quiet-surface.png"))
   (gimp-item-set-visible quiet FALSE))
  (rv-save im "reading-surface")
  (gimp-image-delete im)))
