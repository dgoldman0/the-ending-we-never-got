(define (rv-detail path name x y w h)
 (let* ((im (car (gimp-file-load RUN-NONINTERACTIVE path path))))
  (gimp-image-crop im w h x y)
  (rv-export im (string-append rv-root "review/details/" name ".png"))
  (gimp-image-delete im)))

(define (rv-repair-badge im source cx cy)
 ; Replace only the wrong ray field. Preserve the rendered metal disk itself.
 (gimp-image-select-ellipse im CHANNEL-OP-REPLACE (- cx 27) (+ cy 40) 54 54)
 (gimp-selection-feather im 4)
 (let ((bounds (gimp-selection-bounds im)))
  (gimp-edit-copy source)
  (gimp-selection-none im)
  (let ((cloth (car (gimp-edit-paste source FALSE))))
   (gimp-floating-sel-to-layer cloth)
   (gimp-layer-set-offsets cloth (cadr bounds) (- (caddr bounds) 67))
   (gimp-item-set-name cloth "Cloth repair beneath corrected badge, feathered local donor")))
 (let* ((path "visual-novel/art/prop-keys/emblems/human-temple-sun.png")
        (badge (car (gimp-file-load-layer RUN-NONINTERACTIVE im path))))
  (gimp-image-insert-layer im badge 0 0)
  (gimp-layer-scale badge 72 72 FALSE)
  (gimp-layer-set-offsets badge (- cx 36) (- cy 36))
  (gimp-item-set-name badge "Fixed human temple emblem: twelve short rays"))
 (gimp-image-select-ellipse im CHANNEL-OP-REPLACE (- cx 7) (- cy 7) 14 14)
 (gimp-selection-feather im 1)
 (let ((bounds (gimp-selection-bounds im)))
  (gimp-edit-copy source)
  (gimp-selection-none im)
  (let ((disk (car (gimp-edit-paste source FALSE))))
   (gimp-floating-sel-to-layer disk)
   (gimp-layer-set-offsets disk (cadr bounds) (caddr bounds))
   (gimp-item-set-name disk "Retained modeled brass disk over fixed ray geometry"))))

(define (rv-finish-scene im name mode)
 (let ((intense 0) (soft 0))
  (set! intense (car (gimp-layer-new-from-visible im im "Intense")))
  (set! soft (car (gimp-layer-copy intense TRUE)))
  (gimp-image-insert-layer im intense 0 0)
  (gimp-item-set-name intense "01 Intense, shared environmental exposure")
  (rv-grade intense mode #f)
  (rv-export im (string-append rv-out "cg/" name ".png"))
  (gimp-item-set-visible intense FALSE)
  (gimp-image-insert-layer im soft 0 0)
  (gimp-item-set-name soft "02 Softened, same corrected scene")
  (rv-grade soft mode #t)
  (rv-export im (string-append rv-soft "cg/" name ".png"))
  (gimp-item-set-visible soft FALSE)
  (gimp-item-set-visible intense TRUE)
  (rv-save im name)
  (gimp-image-delete im)))

(define (rv-scene raw name mode . badge-center)
 (let* ((path (string-append rv-root "raw/" raw ".png"))
        (im (car (gimp-file-load RUN-NONINTERACTIVE path path)))
        (source (car (gimp-image-get-active-layer im))))
  (gimp-item-set-name source "00 Retained source, reviewed staging and performance")
  (if (not (null? badge-center))
   (rv-repair-badge im source (car badge-center) (cadr badge-center)))
  (rv-finish-scene im name mode)))

