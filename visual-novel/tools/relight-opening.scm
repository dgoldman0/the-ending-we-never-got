; GIMP 2.10. Replace, rather than accumulate, the rejected grade.
; Preserve all source-state correction layers underneath each new grade.
(load "visual-novel/tools/finish-opening.scm")
(define (light-base name sprite)
 (let* ((p (string-append seq-root "masters/" name ".xcf"))
        (im (car (gimp-file-load RUN-NONINTERACTIVE p p)))
        (ls (gimp-image-get-layers im)))
  (if sprite
   (begin
    (gimp-item-set-visible (vector-ref (cadr ls) 0) FALSE)
    (gimp-item-set-visible (vector-ref (cadr ls) 1) FALSE))
   (if (not (equal? name "phone-message"))
    (gimp-item-set-visible (vector-ref (cadr ls) 0) FALSE)))
  im))
(define (light-scene name category mode earth output)
 (let* ((im (light-base name (equal? category "sprites")))
        (layer (car (gimp-layer-new-from-visible im im "Replacement light - reject comfortable portrait fill"))))
  (gimp-image-insert-layer im layer 0 0)
  (cond
   ((equal? mode "bright")
    (gimp-hue-saturation layer ALL-HUES 0 0 -12)
    (gimp-curves-spline layer HISTOGRAM-VALUE 14 #(0 10 30 76 64 165 110 234 155 251 210 255 255 255)))
   ((equal? mode "ordinary")
    (gimp-hue-saturation layer ALL-HUES 0 0 -22)
    (gimp-color-balance layer MIDTONES TRUE -4 1 6)
    (gimp-curves-spline layer HISTOGRAM-VALUE 14 #(0 0 35 23 70 97 110 190 155 236 210 254 255 255)))
   ((equal? mode "night")
    (gimp-hue-saturation layer ALL-HUES 0 0 -28)
    (gimp-color-balance layer MIDTONES TRUE -15 -2 12)
    (gimp-curves-spline layer HISTOGRAM-VALUE 14 #(0 0 48 5 96 18 140 43 180 96 220 185 255 247))))
  ; GIMP's FALSE is numeric 0, which is truthy in Scheme. Compare explicitly.
  (if (= earth TRUE)
   (begin
    (cond
     ((equal? name "phone-message")
      (gimp-image-select-polygon im CHANNEL-OP-REPLACE 14 #(541 0 1672 0 1672 941 0 941 0 310 533 237 541 0)))
     ((equal? name "milk-impact")
      (gimp-image-select-polygon im CHANNEL-OP-REPLACE 14 #(380 0 1672 0 1672 941 0 941 0 520 360 462 380 0)))
     (else (gimp-image-select-polygon im CHANNEL-OP-REPLACE 18 #(395 0 1672 0 1672 941 0 941 0 760 366 683 365 194 294 0 395 0))))
    (gimp-selection-feather im 8)
    (gimp-layer-add-mask layer (car (gimp-layer-create-mask layer ADD-SELECTION-MASK)))
    (gimp-selection-none im)))
  (if (equal? name "chair-barricade")
   (begin
    (gimp-item-set-visible layer FALSE)
   (let ((contact (car (gimp-layer-new-from-visible im im "Candle reflection on chair and hand contact only - face stays dark"))))
    (gimp-item-set-visible layer TRUE)
    (gimp-image-insert-layer im contact 0 0)
    (gimp-hue-saturation contact ALL-HUES 0 0 -28)
    (gimp-color-balance contact MIDTONES TRUE -15 -2 12)
    (gimp-curves-spline contact HISTOGRAM-VALUE 14 #(0 0 48 32 96 60 140 90 180 123 220 185 255 247))
    (gimp-image-select-polygon im CHANNEL-OP-REPLACE 24 #(1405 392 1459 380 1474 397 1446 506 1448 592 1393 599 1309 599 1317 488 1378 477 1392 426 1389 408 1405 392))
    (gimp-selection-feather im 14)
    (gimp-layer-add-mask contact (car (gimp-layer-create-mask contact ADD-SELECTION-MASK)))
    (gimp-selection-none im))))
  (gimp-xcf-save RUN-NONINTERACTIVE im layer (string-append seq-root "relight-masters/" output ".xcf") output)
  (seq-export im (string-append seq-out category "/" output ".png"))
  (gimp-image-delete im)))
