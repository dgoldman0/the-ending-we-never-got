(load "visual-novel/tools/finish-opening.scm")
(define (two-chairs im)
 (seq-patch im "apartment-two-chairs" "Remove two invented dining chairs; keep window and table seats" '((949 562 188 186) (1089 729 326 212))))
(seq-sprite "tessa-cloaked")
(seq-sprite "mara-supper")
(seq-sprite "tessa-refusal")
(let ((im (seq-load "apartment-window")))
 (seq-patch im "apartment-two-chairs" "Offered dress is empty collapsed cloth" '((610 450 315 225)))
 (two-chairs im)
 (seq-grade im "night" FALSE)
 (seq-deliver im "apartment-window" "cg"))
(let ((im (seq-load "apartment-two-chairs")))
 (seq-grade im "night" FALSE)
 (seq-deliver im "apartment-open" "bg"))
(let ((im (seq-load "apartment-two-chairs")))
