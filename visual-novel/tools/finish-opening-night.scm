 (seq-grade im "night" FALSE)
 (seq-deliver im "cloak-discarded" "cg"))
; The paper tear is a tiny local painted layer, not another full regeneration.
(define (paper-tear im)
 (let ((layer (car (gimp-layer-new im 1672 941 RGBA-IMAGE "Small pen tear: dark slit and lifted paper edge" 100 NORMAL-MODE))))
  (gimp-image-insert-layer im layer 0 0)
  (gimp-context-set-foreground '(49 33 25))
  (gimp-image-select-polygon im CHANNEL-OP-REPLACE 20 #(942 744 950 750 951 755 960 762 964 768 959 765 954 760 947 756 948 752 942 746))
  (gimp-edit-fill layer FOREGROUND-FILL)
  (gimp-context-set-foreground '(229 208 175))
  (gimp-image-select-polygon im CHANNEL-OP-REPLACE 12 #(943 746 950 754 957 762 961 765 954 761 947 755))
  (gimp-edit-fill layer FOREGROUND-FILL)
  (gimp-selection-none im)))
(for-each (lambda (name)
 (let ((im (seq-load name)))
  (paper-tear im)
  (seq-grade im "night" FALSE)
  (seq-deliver im name "cg"))) '("drawing-letter" "drawing-restart"))
(seq-crop "visual-novel/renpy/game/art/opening/cg/drawing-restart.png" 718 704 586 204 "visual-novel/renpy/game/art/opening/cg/detail-drawing.png")
(seq-crop "visual-novel/renpy/game/art/opening/cg/drawing-restart.png" 1310 746 275 160 "visual-novel/renpy/game/art/opening/cg/detail-phone.png")
(gimp-quit 0)
