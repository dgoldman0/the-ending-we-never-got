(load "visual-novel/tools/finish-opening.scm")
; Base plates and cast retain their original layers and alpha-cleaned variants.
(seq-arrival)
(seq-sprite "tessa-question")
(seq-sprite "tessa-refusal")
(seq-sprite "tessa-cloaked")
(seq-sprite "senn-speaking")
(seq-sprite "mara-supper")
; Preserve Mara's original face and costume. Only her rank bar changes.
(let* ((im (seq-load "mara-cloak")))
 (seq-patch im "mara-supper" "Single rank bar - collar only" '((589 347 68 60)))
 (seq-export im (string-append seq-root "raw/mara-cloak-corrected.png"))
 (seq-save im "mara-collar-repair")
