(let ((im (seq-load "arch-conversation")))
 (seq-patch im "arch-clean-floor" "Remove old misplaced groceries without copying feet" '((399 624 213 199)))
 (seq-grocery-and-control im)
 (seq-patch im "arch-guards-raised" "Guards before lowering shields" '((716 255 299 407)))
