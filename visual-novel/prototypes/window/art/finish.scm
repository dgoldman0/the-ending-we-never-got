(define (new-layer im name)
 (let ((layer (car (gimp-layer-new im (car (gimp-image-width im)) (car (gimp-image-height im)) RGBA-IMAGE name 100 NORMAL-MODE))))
  (gimp-image-insert-layer im layer 0 0) layer))
(define (poly im layer points color)
 (gimp-image-select-polygon im CHANNEL-OP-REPLACE (vector-length points) points)
 (gimp-context-set-foreground color) (gimp-edit-fill layer FOREGROUND-FILL) (gimp-selection-none im))
(define (patch im base sx sy x y)
 (let ((layer (new-layer im "Cloth repair beneath incorrect generated rays")))
  (gimp-image-select-rectangle im CHANNEL-OP-REPLACE sx sy 100 116)
  (gimp-edit-copy base) (gimp-selection-none im)
  (let ((floating (car (gimp-edit-paste layer FALSE))))
   (gimp-layer-set-offsets floating x y) (gimp-floating-sel-anchor floating))
  (gimp-image-select-ellipse im CHANNEL-OP-REPLACE (+ x 5) (+ y 9) 90 98)
  (gimp-selection-feather im 8)
  (gimp-layer-add-mask layer (car (gimp-layer-create-mask layer ADD-SELECTION-MASK)))
  (gimp-selection-none im)))
(define (png im path)
 (let* ((copy (car (gimp-image-duplicate im))) (flat (car (gimp-image-merge-visible-layers copy CLIP-TO-IMAGE))))
  (file-png-save RUN-NONINTERACTIVE copy flat path path 0 9 0 0 0 0 0)
  (gimp-image-delete copy)))
