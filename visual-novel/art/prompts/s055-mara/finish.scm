(let* ((im (car (gimp-file-load RUN-NONINTERACTIVE "visual-novel/art/scene-studies/s055-mara/initial-source.png" "initial-source.png"))) (base (car (gimp-image-get-active-layer im))) (donor 0) (mask 0) (clean 0) (flat 0))
(gimp-context-set-interpolation INTERPOLATION-NOHALO)
(gimp-item-set-name base "Original four identities, supported full bodies, stair and cloth")
(set! donor (car (gimp-file-load-layer RUN-NONINTERACTIVE im "visual-novel/art/scene-studies/s055-mara/contact-uniform-donor.png")))
(gimp-image-insert-layer im donor 0 -1) (gimp-item-set-name donor "Bounded LEFT pulse contact and plain Mara uniform")
(set! mask (car (gimp-layer-create-mask donor ADD-BLACK-MASK))) (gimp-layer-add-mask donor mask)
(gimp-image-select-polygon im CHANNEL-OP-REPLACE 28 #(758 250 807 280 904 355 992 403 995 449 918 455 844 455 792 459 772 424 771 376 765 357 738 299 744 275 758 250))
(gimp-selection-feather im 4) (gimp-edit-fill mask WHITE-FILL) (gimp-selection-none im)
(gimp-image-select-polygon im CHANNEL-OP-REPLACE 26 #(776 471 814 438 842 423 879 403 967 428 1048 448 1028 485 973 524 912 573 860 595 814 582 768 550 734 508))
(gimp-selection-feather im 4) (gimp-edit-fill mask WHITE-FILL) (gimp-selection-none im)
(set! clean (car (gimp-layer-new im 1672 941 RGBA-IMAGE "Remove residual Saint ornament on Mara's plain navy chest" 100 NORMAL-MODE)))
(gimp-image-insert-layer im clean 0 -1)
(gimp-image-select-ellipse im CHANNEL-OP-REPLACE 862 416 31 15) (gimp-selection-feather im 2)
(gimp-context-set-brush "2. Hardness 075") (gimp-context-set-brush-size 35)
(gimp-clone clean donor CLONE-IMAGE 905 433 2 #(877 423)) (gimp-selection-none im)
(gimp-xcf-save RUN-NONINTERACTIVE im base "visual-novel/art/scene-studies/s055-mara/mara-native-master.xcf" "mara-native-master.xcf")
(gimp-image-scale im 1920 1080)
(gimp-xcf-save RUN-NONINTERACTIVE im base "visual-novel/art/scene-studies/s055-mara/mara-master.xcf" "mara-master.xcf")
(set! flat (car (gimp-image-merge-visible-layers im CLIP-TO-IMAGE)))
(file-png-save RUN-NONINTERACTIVE im flat "/tmp/s055-mara-final-candidate.png" "/tmp/s055-mara-final-candidate.png" 0 9 0 0 0 0 0)
(gimp-image-delete im)) (gimp-quit 0)
