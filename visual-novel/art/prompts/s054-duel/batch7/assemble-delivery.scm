(define (save-png img path)
 (let* ((dup (car (gimp-image-duplicate img))) (flat (car (gimp-image-merge-visible-layers dup CLIP-TO-IMAGE))))
  (gimp-layer-resize-to-image-size flat)
  (file-png-save RUN-NONINTERACTIVE dup flat path path 0 9 0 0 0 0 0)
  (gimp-image-delete dup)))
(let* ((dir "visual-novel/art/scene-studies/s054-duel/batch7/")
       (path (string-append dir "05-shell-donor.png"))
       (img (car (gimp-file-load RUN-NONINTERACTIVE path path)))
       (base (car (gimp-image-get-active-layer img)))
       (dais (car (gimp-file-load-layer RUN-NONINTERACTIVE img (string-append dir "06-dais-donor.png")))))
 (gimp-item-set-name base "Rebuilt physical blocking - corrected limbs and exterior shelter")
 (gimp-image-insert-layer img dais 0 0) (gimp-layer-scale dais 800 475 TRUE) (gimp-layer-set-offsets dais 872 466)
 (gimp-item-set-name dais "Three-riser stone dais - background only")
 (let ((mask (car (gimp-layer-create-mask dais ADD-BLACK-MASK))))
  (gimp-layer-add-mask dais mask)
  (gimp-image-select-polygon img CHANNEL-OP-REPLACE 26 #(883 515 1113 515 1102 546 1084 563 1066 585 1065 612 1076 642 1092 670 1090 705 1086 753 1072 784 888 785 879 661))
  (gimp-image-select-polygon img CHANNEL-OP-ADD 24 #(1453 515 1672 515 1672 790 1575 790 1547 748 1523 703 1508 671 1500 639 1488 613 1471 584 1458 553 1453 540))
  (gimp-image-select-polygon img CHANNEL-OP-ADD 28 #(1117 694 1151 670 1197 685 1245 727 1255 727 1310 704 1340 704 1390 727 1440 729 1460 781 1480 791 1080 791 1090 743 1105 705))
  (gimp-selection-feather img 3) (gimp-context-set-foreground '(255 255 255)) (gimp-edit-fill mask FOREGROUND-FILL) (gimp-selection-none img))
 (let ((cloth (car (gimp-layer-copy base TRUE))))
  (gimp-image-insert-layer img cloth 0 0) (gimp-item-set-name cloth "Adjacent coat cloth under correct sun") (gimp-layer-set-offsets cloth 0 -33)
  (let ((mask (car (gimp-layer-create-mask cloth ADD-BLACK-MASK))))
   (gimp-layer-add-mask cloth mask) (gimp-image-select-ellipse img CHANNEL-OP-REPLACE 386 323 28 31) (gimp-selection-feather img 2) (gimp-edit-fill mask FOREGROUND-FILL) (gimp-selection-none img)))
 (let ((sun (car (gimp-file-load-layer RUN-NONINTERACTIVE img "visual-novel/art/prop-keys/emblems/human-temple-sun.png"))))
  (gimp-image-insert-layer img sun 0 0) (gimp-item-set-name sun "Fixed twelve-ray brass temple sun") (gimp-layer-scale sun 25 25 TRUE) (gimp-layer-set-offsets sun 387 325))
 (gimp-xcf-save RUN-NONINTERACTIVE img base (string-append dir "native-master.xcf") (string-append dir "native-master.xcf"))
 (save-png img (string-append dir "native-candidate.png"))
 (gimp-image-scale img 1920 1081) (gimp-image-resize img 1920 1080 0 0)
 (gimp-xcf-save RUN-NONINTERACTIVE img base (string-append dir "delivery-master.xcf") (string-append dir "delivery-master.xcf"))
 (save-png img (string-append dir "candidate.png"))
 (gimp-image-delete img)
 (let* ((saved (string-append dir "delivery-master.xcf")) (reopened (car (gimp-file-load RUN-NONINTERACTIVE saved saved))))
  (save-png reopened (string-append dir "reopened.png")) (gimp-image-delete reopened)))
(gimp-quit 0)
