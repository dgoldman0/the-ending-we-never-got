(let* ((path "visual-novel/art/scene-studies/s054-duel/batch7/05-shell-donor.png")
       (img (car (gimp-file-load RUN-NONINTERACTIVE path path)))
       (base (car (gimp-image-get-active-layer img)))
       (layer (car (gimp-layer-new img 1672 941 RGBA-IMAGE "GUIDE ONLY - three physical stone risers" 100 NORMAL-MODE))))
 (gimp-image-insert-layer img layer 0 0)
 (gimp-drawable-fill layer TRANSPARENT-FILL)
 (for-each (lambda (v)
   (gimp-image-select-rectangle img CHANNEL-OP-REPLACE 872 (car v) 800 (cadr v))
   (gimp-context-set-foreground (caddr v)) (gimp-edit-fill layer FOREGROUND-FILL))
   '((530 18 (111 108 103)) (548 20 (76 74 71)) (568 27 (128 125 119)) (595 20 (79 77 74)) (615 34 (125 122 116)) (649 21 (82 79 75)) (670 120 (138 133 125))))
 (gimp-selection-none img)
 (let ((mask (car (gimp-layer-create-mask layer ADD-BLACK-MASK))))
  (gimp-layer-add-mask layer mask)
  (gimp-image-select-polygon img CHANNEL-OP-REPLACE 26 #(883 530 1107 530 1102 546 1084 563 1066 585 1065 612 1076 642 1092 670 1090 705 1086 753 1072 784 888 785 879 661))
  (gimp-image-select-polygon img CHANNEL-OP-ADD 24 #(1453 530 1672 530 1672 790 1575 790 1547 748 1523 703 1508 671 1500 639 1488 613 1471 584 1458 553 1453 540))
  (gimp-context-set-foreground '(255 255 255)) (gimp-edit-fill mask FOREGROUND-FILL) (gimp-selection-none img))
 (gimp-xcf-save RUN-NONINTERACTIVE img layer "visual-novel/art/scene-studies/s054-duel/batch7/three-step-guide.xcf" "visual-novel/art/scene-studies/s054-duel/batch7/three-step-guide.xcf")
 (let ((flat (car (gimp-image-merge-visible-layers img CLIP-TO-IMAGE))))
  (gimp-image-crop img 800 475 872 466)
  (file-png-save RUN-NONINTERACTIVE img flat "visual-novel/art/scene-studies/s054-duel/batch7/three-step-guide.png" "visual-novel/art/scene-studies/s054-duel/batch7/three-step-guide.png" 0 9 0 0 0 0 0))
 (gimp-image-delete img))
(gimp-quit 0)
