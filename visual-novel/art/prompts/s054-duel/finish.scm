 (gimp-selection-none img)
 (gimp-xcf-save RUN-NONINTERACTIVE img cap "visual-novel/art/scene-studies/s054-duel/duel-local-master.xcf" "master")
 (gimp-context-set-interpolation INTERPOLATION-NOHALO) (gimp-image-scale img 1920 1080)
