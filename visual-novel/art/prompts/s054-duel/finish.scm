 (gimp-layer-scale dais 300 345 FALSE) (gimp-layer-set-offsets dais 830 320)
 (gimp-item-set-name dais "Only three low risers, lowered throne and rear release")
 (gimp-image-select-polygon img CHANNEL-OP-REPLACE 44 (vector 850 340 950 334 1032 334 1070 367 1090 399 1080 428 1065 447 1050 470 1050 503 1038 514 1028 548 1033 583 1042 601 1042 635 837 644 839 606 855 557 865 500 872 448 874 400 868 370 850 355))
 (gimp-image-select-polygon img CHANNEL-OP-ADD 16 (vector 1040 339 1084 335 1097 365 1094 407 1069 397 1062 378 1052 360 1039 347))
 (gimp-selection-feather img 2)
 (let ((mask (car (gimp-layer-create-mask dais ADD-SELECTION-MASK)))) (gimp-layer-add-mask dais mask))
 (gimp-selection-none img)
 (gimp-image-insert-layer img clean 0 0) (gimp-drawable-fill clean TRANSPARENT-FILL)
 (gimp-context-set-brush "2. Hardness 075") (gimp-context-set-brush-size 28)
 (gimp-image-select-rectangle img CHANNEL-OP-REPLACE 1496 310 115 40)
