       (src (vector-ref layers 3)))
 (gimp-context-set-interpolation INTERPOLATION-NOHALO)
 (gimp-image-scale img 1190 670) (gimp-image-resize img 1920 1080 350 80)
 (let ((room (car (gimp-file-load-layer RUN-NONINTERACTIVE img "visual-novel/art/scene-studies/s058-final/environment-extension-component.png"))))
  (gimp-image-insert-layer img room 0 4) (gimp-layer-scale room 1920 1080 FALSE) (gimp-layer-set-offsets room 0 0)
  (gimp-item-set-name room "Generated room borders, stone floor and finished slip-on shoe tips only")
  (gimp-image-select-polygon img CHANNEL-OP-REPLACE 68 (vector 414 379 457 347 474 237 517 205 627 205 634 133 685 91 756 91 818 170 852 151 876 80 991 80 1034 194 1119 194 1147 148 1282 137 1439 133 1503 158 1524 326 1510 397 1540 621 1540 750 1047 750 1019 725 1001 725 976 739 926 742 872 746 813 748 790 750 578 750 512 744 450 742 415 607)) (gimp-selection-feather img 9)
  (gimp-image-select-rectangle img CHANNEL-OP-SUBTRACT 395 428 31 110) (gimp-selection-feather img 2)
  (gimp-layer-add-mask src (car (gimp-layer-create-mask src ADD-SELECTION-MASK))) (gimp-selection-none img)
  (gimp-item-set-name src "Original eight actors, supported chair and table; uniform whole-image scale; soft perimeter")
  (gimp-xcf-save RUN-NONINTERACTIVE img src "visual-novel/art/scene-studies/s058-final/chair-delivery-master.xcf" "master")
