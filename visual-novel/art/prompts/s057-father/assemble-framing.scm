(let* ((im(car(gimp-file-load RUN-NONINTERACTIVE "visual-novel/art/scene-studies/s057-father/native-master.xcf" "visual-novel/art/scene-studies/s057-father/native-master.xcf")))(bg 0)(f 0)(base 0)(m 0))
(set! base (vector-ref (cadr(gimp-image-get-layers im)) 0))
(set! base (vector-ref (cadr(gimp-image-get-layers im)) (- (car(gimp-image-get-layers im)) 1)))
(gimp-image-resize im 2240 1260 284 100)
(set! m(car(gimp-layer-create-mask base ADD-BLACK-MASK)))(gimp-layer-add-mask base m)
(gimp-image-select-rectangle im CHANNEL-OP-REPLACE 340 118 1590 880)
