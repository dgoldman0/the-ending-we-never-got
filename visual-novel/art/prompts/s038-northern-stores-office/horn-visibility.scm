; Item14: full portrait-surface masks at the original .22 uniform scale and fixed roots.
; The former near mask clipped the rounded contour; the far mask ended above its actual root.
; Only two masked horn layers receive the restrained local value curve.
(define (source-delivery path)
 (let* ((im (car (gimp-file-load RUN-NONINTERACTIVE path path))) (flat (car (gimp-image-merge-visible-layers im CLIP-TO-IMAGE))))
 (gimp-context-set-interpolation INTERPOLATION-NOHALO)
 (gimp-image-crop im 1664 936 4 2) (gimp-image-scale im 1920 1080) im))
(define (horn im name points tx ty)
 (let* ((l (car (gimp-file-load-layer RUN-NONINTERACTIVE im "visual-novel/renpy/game/art/portraits/marren-speaking.png"))) (m 0))
  (gimp-image-insert-layer im l 0 0) (gimp-item-set-name l name)
  (set! m (car (gimp-layer-create-mask l ADD-BLACK-MASK))) (gimp-layer-add-mask l m)
  (gimp-image-select-polygon im CHANNEL-OP-REPLACE (vector-length points) points)
  (gimp-selection-feather im 1.0) (gimp-edit-fill m WHITE-FILL) (gimp-selection-none im)
  (gimp-context-set-interpolation INTERPOLATION-NOHALO)
  (gimp-item-transform-matrix l 0.22 0 tx 0 0.22 ty 0 0 1)
  (gimp-curves-spline l HISTOGRAM-VALUE 10 #(0 0 45 40 115 140 190 208 255 255)) l))
(let* ((im (source-delivery "visual-novel/art/scene-studies/s038-northern-stores-office/office-local-master.xcf"))
 (base (car (gimp-image-get-active-layer im))) (l 0) (flat 0))
(gimp-item-set-name base "Delivered office before requested readable Marren horns correction")
(set! l (horn im "Marren near rounded horn from current portrait; bounded exposed surface, unchanged root anchor" #(472 260 466 263 461 269 457 278 455 288 455 299 457 311 462 323 470 333 480 340 491 344 502 341 513 334 522 324 529 315 531 306 527 298 519 293 509 289 500 284 493 278 487 271 480 264) 728.78 123.86))
(set! l (horn im "Marren far rounded horn from same portrait; bounded exposed surface, unchanged root anchor" #(821 277 817 278 813 282 809 287 806 292 802 298 800 306 801 315 804 326 807 337 811 346 814 350 817 353 821 347 826 339 830 330 833 321 835 312 835 300 833 292 831 286 827 281 824 278) 721.1 126.3))
(gimp-xcf-save RUN-NONINTERACTIVE im l "visual-novel/art/scene-studies/s038-northern-stores-office/office-horn-visibility-master.xcf" "visual-novel/art/scene-studies/s038-northern-stores-office/office-horn-visibility-master.xcf")
(set! flat (car (gimp-image-merge-visible-layers im CLIP-TO-IMAGE)))
(file-png-save RUN-NONINTERACTIVE im flat "visual-novel/renpy/game/art/scenes/s038-northern-stores-office.png" "visual-novel/renpy/game/art/scenes/s038-northern-stores-office.png" 0 9 0 0 0 0 0)
(gimp-image-delete im)) (gimp-quit 0)
