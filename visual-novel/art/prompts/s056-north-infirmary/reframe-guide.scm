(let* ((im (car (gimp-image-new 1952 1098 RGB))) (bg (car (gimp-layer-new im 1952 1098 RGB-IMAGE "Margin guide" 100 NORMAL-MODE))) (src 0) (flat 0))
(gimp-image-insert-layer im bg 0 -1)
(gimp-context-set-background '(112 112 112))
(gimp-drawable-fill bg BACKGROUND-FILL)
(set! src (car (gimp-file-load-layer RUN-NONINTERACTIVE im "visual-novel/art/scene-studies/s056-north-infirmary/generation-initial.png")))
(gimp-image-insert-layer im src 0 -1)
(gimp-layer-set-offsets src 140 85)
(set! flat (car (gimp-image-merge-visible-layers im CLIP-TO-IMAGE)))
(file-png-save RUN-NONINTERACTIVE im flat "/tmp/s056-base-margin-guide.png" "/tmp/s056-base-margin-guide.png" 0 9 0 0 0 0 0)
(gimp-image-delete im))
(gimp-quit 0)
