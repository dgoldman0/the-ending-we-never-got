(let* ((img (car (gimp-file-load RUN-NONINTERACTIVE "visual-novel/art/scene-studies/s054-wound/wound-framed-master.xcf" "master")))
       (oldlayers (cadr (gimp-image-get-layers img)))
       (actiongroup (vector-ref oldlayers 0)))
 (gimp-layer-remove-mask actiongroup MASK-DISCARD)
 (gimp-image-select-polygon img CHANNEL-OP-REPLACE 26 (vector 600 710 600 570 670 530 760 550 840 595 1030 660 1315 835 1350 900 1260 925 1170 950 880 920 650 910 585 840))
 (gimp-image-select-polygon img CHANNEL-OP-ADD 28 (vector 1410 105 1635 80 1830 205 1840 450 1970 890 1990 945 1840 945 1700 650 1590 865 1580 930 1370 930 1410 600 1380 450 1360 355))
 (gimp-image-select-rectangle img CHANNEL-OP-ADD 1060 320 390 410)
