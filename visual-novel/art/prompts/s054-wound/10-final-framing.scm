 (let ((mask (car (gimp-layer-create-mask actiongroup ADD-SELECTION-MASK)))) (gimp-layer-add-mask actiongroup mask))
 (gimp-selection-none img)
 (gimp-context-set-interpolation INTERPOLATION-NOHALO)
