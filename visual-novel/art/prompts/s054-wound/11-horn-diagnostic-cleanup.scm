(let* ((img (car (gimp-file-load RUN-NONINTERACTIVE "visual-novel/art/scene-studies/s054-wound/wound-delivery-master.xcf" "master")))
       (src (car (gimp-layer-new-from-visible img img "Hidden pre-tip composite for local stone sample")))
       (clean (car (gimp-layer-new img 1920 1080 RGBA-IMAGE "Remove detached donor horn tip and source-edge seam; finish original tip" 100 NORMAL-MODE))))
 (gimp-image-insert-layer img src 0 0) (gimp-item-set-visible src FALSE)
 (gimp-image-insert-layer img clean 0 0) (gimp-drawable-fill clean TRANSPARENT-FILL)
 (gimp-context-set-brush "2. Hardness 075") (gimp-context-set-brush-size 28)
 (gimp-image-select-polygon img CHANNEL-OP-REPLACE 12 (vector 1272 91 1296 88 1299 112 1292 121 1270 123 1268 106))
 (gimp-selection-feather img 3)
 (gimp-clone clean src CLONE-IMAGE 1250 103 4 (vector 1284 102 1284 114))
 (gimp-selection-none img)
 (gimp-image-select-rectangle img CHANNEL-OP-REPLACE 1215 114 69 11) (gimp-selection-feather img 2)
 (for-each (lambda (x) (gimp-clone clean src CLONE-IMAGE x 103 2 (vector x 119))) '(1220 1236 1252 1268 1280))
 (gimp-selection-none img)
 (gimp-context-set-foreground '(48 43 38)) (gimp-context-set-brush-size 2.4)
 (gimp-paintbrush-default clean 6 (vector 1294 122 1296 119 1297 117))
 (gimp-xcf-save RUN-NONINTERACTIVE img clean "visual-novel/art/scene-studies/s054-wound/wound-delivery-master.xcf" "master")
 (let ((flat (car (gimp-image-merge-visible-layers img CLIP-TO-IMAGE)))) (file-png-save RUN-NONINTERACTIVE img flat "/tmp/s054-wound-final-review.png" "review" 0 9 0 0 0 0 0))
 (gimp-image-delete img))
