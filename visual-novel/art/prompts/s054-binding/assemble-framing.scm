(let* ((im(car(gimp-file-load RUN-NONINTERACTIVE "visual-novel/art/scene-studies/s054-binding/action-rebuild.png" "visual-novel/art/scene-studies/s054-binding/action-rebuild.png")))(bg 0)(f 0)(base 0)(m 0))
