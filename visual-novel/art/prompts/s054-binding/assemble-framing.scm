(gimp-item-set-name bg "Peripheral hall, Olan headroom and completed boot")
(gimp-xcf-save RUN-NONINTERACTIVE im base "visual-novel/art/scene-studies/s054-binding/delivery-master.xcf" "visual-novel/art/scene-studies/s054-binding/delivery-master.xcf")
