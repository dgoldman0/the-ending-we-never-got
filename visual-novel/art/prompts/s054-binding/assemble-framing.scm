(file-png-save RUN-NONINTERACTIVE im f "visual-novel/art/scene-studies/s054-binding/candidate.png" "visual-novel/art/scene-studies/s054-binding/candidate.png" 0 9 0 0 0 0 0)
(gimp-image-delete im))(gimp-quit 0)
