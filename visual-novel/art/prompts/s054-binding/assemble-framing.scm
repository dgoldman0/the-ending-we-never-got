(gimp-image-resize im 2240 1260 284 160)
(set! m(car(gimp-layer-create-mask base ADD-BLACK-MASK)))(gimp-layer-add-mask base m)
(gimp-image-select-rectangle im CHANNEL-OP-REPLACE 308 182 1624 874)
(gimp-selection-feather im 20)(gimp-edit-fill m WHITE-FILL)(gimp-selection-none im)
