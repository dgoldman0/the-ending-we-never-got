; Run from repository root with GIMP 2.10.36. Retains actual source and bounded components.
(define (white-mask img layer points radius)
 (gimp-image-select-polygon img CHANNEL-OP-REPLACE (vector-length points) points)
 (gimp-selection-feather img radius)
 (let ((mask (car (gimp-layer-create-mask layer ADD-BLACK-MASK))))
  (gimp-layer-add-mask layer mask)
  (gimp-context-set-foreground '(255 255 255))
  (gimp-edit-fill mask FOREGROUND-FILL))
 (gimp-selection-none img))
(let* ((folder "visual-novel/art/scene-studies/s049-command-tent/")
       (img (car (gimp-file-load RUN-NONINTERACTIVE (string-append folder "command-source.png") "source")))
       (base (car (gimp-image-get-active-layer img)))
       (shield (car (gimp-file-load-layer RUN-NONINTERACTIVE img (string-append folder "olan-shield-component.png"))))
 (gimp-image-insert-layer img shield 0 0)
 (gimp-item-set-name shield "Olan lower arms, RIGHT shield and LEFT healthy hand only")
 (white-mask img shield (vector 1360 343 1635 343 1672 460 1672 941 1340 941 1360 774 1365 657 1390 559 1340 548 1315 542 1315 490 1330 445 1340 390) 3)
 (gimp-context-set-interpolation INTERPOLATION-NOHALO)
 (let ((paper (car (gimp-file-load-layer RUN-NONINTERACTIVE img (string-append folder "interior-blank-paper-component.png")))))
  (gimp-image-insert-layer img paper 0 0)
  (gimp-layer-scale paper 780 280 FALSE)
  (gimp-layer-set-offsets paper 240 480)
  (gimp-item-set-name paper "Interior sheet blank only; hands and page edges original")
  (white-mask img paper (vector 442 537 957 544 910 690 392 635 390 588 484 574 484 525) 3))
 (gimp-image-resize img 2016 1134 172 55)
 (gimp-layer-add-alpha base)
 (gimp-image-select-rectangle img CHANNEL-OP-REPLACE 176 59 1664 933)
 (gimp-selection-feather img 7)
 (let ((mask (car (gimp-layer-create-mask base ADD-BLACK-MASK))))
  (gimp-layer-add-mask base mask)
  (gimp-context-set-foreground '(255 255 255))
  (gimp-edit-fill mask FOREGROUND-FILL)
  (gimp-image-select-polygon img CHANNEL-OP-REPLACE 16 (vector 149 781 248 790 297 813 329 850 326 1004 159 1008 145 910 145 822))
  (gimp-selection-feather img 8)
  (gimp-context-set-foreground '(0 0 0))
  (gimp-edit-fill mask FOREGROUND-FILL))
 (gimp-selection-none img)
 (gimp-item-set-name base "Original cast and table; outer seams and cut left chest masked to floor")
 (let ((border (car (gimp-file-load-layer RUN-NONINTERACTIVE img (string-append folder "framing-border-component.png")))))
  (gimp-image-insert-layer img border 0 3)
  (gimp-layer-scale border 2016 1134 FALSE)
  (gimp-layer-set-offsets border 0 0)
  (gimp-item-set-name border "Generated outer tent/floor continuation only"))
 (let ((ink (car (gimp-file-load-layer RUN-NONINTERACTIVE img (string-append folder "interior-plan-ink.png")))))
  (gimp-image-insert-layer img ink 0 0)
  (gimp-item-set-name ink "Readable finite interior ink: rectangular hall, two pillar rows, uncertain lever")
  (gimp-item-transform-perspective ink 567 570 1147 603 477 688 1062 747)
  (white-mask img ink (vector 563 638 578 635 602 625 659 625 662 579 1141 601 1078 746 521 687 527 656) 1))
 (gimp-xcf-save RUN-NONINTERACTIVE img base (string-append folder "command-local-master.xcf") "master")
 (gimp-image-scale img 1920 1080)
 (gimp-xcf-save RUN-NONINTERACTIVE img base (string-append folder "command-delivery-master.xcf") "master")
 (let ((flat (car (gimp-image-merge-visible-layers img CLIP-TO-IMAGE))))
  (file-png-save RUN-NONINTERACTIVE img flat "/tmp/s049-rebuilt-review.png" "review" 0 9 0 0 0 0 0))
 (gimp-image-delete img))
