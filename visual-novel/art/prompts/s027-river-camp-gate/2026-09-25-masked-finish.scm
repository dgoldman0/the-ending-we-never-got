; Local corrections: original scene remains untouched beneath individually masked layers.
(define (mask-polygons image layer polygons)
  (let ((mask (car (gimp-layer-create-mask layer ADD-BLACK-MASK))))
    (gimp-layer-add-mask layer mask)
    (gimp-selection-none image)
    (for-each (lambda (poly) (gimp-image-select-polygon image CHANNEL-OP-ADD (vector-length poly) poly)) polygons)
    (gimp-selection-feather image 0.65)
    (gimp-context-set-foreground '(255 255 255))
    (gimp-edit-fill mask FOREGROUND-FILL)
    (gimp-selection-none image)))
(define (component image file name width height x y polygons)
  (let ((layer (car (gimp-file-load-layer RUN-NONINTERACTIVE image file))))
    (gimp-image-insert-layer image layer 0 0)
    (gimp-item-set-name layer name)
    (gimp-layer-scale layer width height FALSE)
    (gimp-layer-set-offsets layer x y)
    (mask-polygons image layer polygons)
    layer))
