 (let ((flat (car (gimp-image-merge-visible-layers im CLIP-TO-IMAGE)))) (file-png-save RUN-NONINTERACTIVE im flat "visual-novel/art/scene-studies/batch6-gray-scar/s020-gray-scar-riverbank-candidate.png" "visual-novel/art/scene-studies/batch6-gray-scar/s020-gray-scar-riverbank-candidate.png" 0 9 0 0 0 0 0))
