(define (masked-component im file name w h x y polygons)
 (let* ((l (car (gimp-file-load-layer RUN-NONINTERACTIVE im file))) (mask 0))
  (gimp-image-insert-layer im l 0 0)
  (gimp-item-set-name l name)
  (gimp-layer-scale l w h FALSE)
  (gimp-layer-set-offsets l x y)
  (set! mask (car (gimp-layer-create-mask l ADD-BLACK-MASK)))
  (gimp-layer-add-mask l mask)
  (gimp-selection-none im)
  (for-each (lambda (p) (gimp-image-select-polygon im CHANNEL-OP-ADD (vector-length p) p)) polygons)
  (gimp-selection-feather im 0.5)
  (gimp-context-set-foreground '(255 255 255))
  (gimp-edit-fill mask FOREGROUND-FILL)
  (gimp-selection-none im) l))
(gimp-context-set-interpolation INTERPOLATION-NOHALO)
