(define (masked-component im file name w h x y polygons)
 (let* ((l (car (gimp-file-load-layer RUN-NONINTERACTIVE im file))) (mask 0))
  (gimp-image-insert-layer im l 0 0)
  (gimp-item-set-name l name)
  (gimp-layer-scale l w h FALSE)
  (gimp-layer-set-offsets l x y)
  (set! mask (car (gimp-layer-create-mask l ADD-BLACK-MASK)))
  (gimp-layer-add-mask l mask)
  (gimp-selection-none im)
  (for-each (lambda (p) (gimp-image-select-polygon im CHANNEL-OP-ADD (vector-length p) p)) polygons)
  (gimp-selection-feather im 0.5)
  (gimp-context-set-foreground '(255 255 255))
  (gimp-edit-fill mask FOREGROUND-FILL)
  (gimp-selection-none im) l))
(gimp-context-set-interpolation INTERPOLATION-NOHALO)
(let* ((im (car (gimp-file-load RUN-NONINTERACTIVE "visual-novel/art/scene-studies/batch6-gray-scar/s018-gray-scar-ferry-approach-master.xcf" "visual-novel/art/scene-studies/batch6-gray-scar/s018-gray-scar-ferry-approach-master.xcf"))) (base (car (gimp-image-get-active-layer im))))
 (masked-component im "visual-novel/art/scene-studies/batch6-gray-scar/s018-pursuit-donor.png" "Final - complete replacement of rifle hand and barrel footprint" 1920 1080 0 0 (list (vector 990 490 1250 490 1250 675 990 675)))
 (masked-component im "visual-novel/art/scene-studies/batch6-gray-scar/s018-hooded-horns-donor.png" "Final - northern hood openings and small paired horns, preserve faces" 135 175 1300 560 (list (vector 1360 592 1368 591 1370 599 1373 604 1370 609 1364 606 1360 600) (vector 1383 593 1392 592 1395 599 1391 607 1384 609 1381 604) (vector 1367 643 1372 641 1375 647 1377 653 1373 656 1368 651) (vector 1387 643 1393 642 1396 647 1393 653 1387 655 1385 651)))
 (gimp-xcf-save RUN-NONINTERACTIVE im base "visual-novel/art/scene-studies/batch6-gray-scar/s018-gray-scar-ferry-approach-master.xcf" "visual-novel/art/scene-studies/batch6-gray-scar/s018-gray-scar-ferry-approach-master.xcf")
 (let ((flat (car (gimp-image-merge-visible-layers im CLIP-TO-IMAGE)))) (file-png-save RUN-NONINTERACTIVE im flat "visual-novel/art/scene-studies/batch6-gray-scar/s018-gray-scar-ferry-approach-candidate.png" "visual-novel/art/scene-studies/batch6-gray-scar/s018-gray-scar-ferry-approach-candidate.png" 0 9 0 0 0 0 0))
 (gimp-image-delete im))
(gimp-quit 0)
