(define root "visual-novel/art/scene-studies/batch6-gray-scar/new-moments/")
(define (path n) (string-append root n))
(define (load-image n) (car (gimp-file-load RUN-NONINTERACTIVE (path n) (path n))))
(define (component im n label w h x y polys)
 (let* ((l (car(gimp-file-load-layer RUN-NONINTERACTIVE im (path n))))(m 0))
  (gimp-image-insert-layer im l 0 0)(gimp-item-set-name l label)
  (gimp-layer-scale l w h FALSE)(gimp-layer-set-offsets l x y)
  (set! m(car(gimp-layer-create-mask l ADD-BLACK-MASK)))(gimp-layer-add-mask l m)
  (gimp-selection-none im)
  (for-each(lambda(p)(gimp-image-select-polygon im CHANNEL-OP-ADD (vector-length p) p))polys)
  (gimp-selection-feather im 0.6)(gimp-edit-fill m WHITE-FILL)(gimp-selection-none im) l))
(define (new-clean im label)
 (let((l(car(gimp-layer-new im (car(gimp-image-width im)) (car(gimp-image-height im)) RGBA-IMAGE label 100 NORMAL-MODE))))
  (gimp-image-insert-layer im l 0 0) l))
(define (clone-disc im clean ref sx sy dx dy w h)
 (gimp-image-select-ellipse im CHANNEL-OP-REPLACE (- dx (/ w 2)) (- dy (/ h 2)) w h)
 (gimp-selection-feather im 0.7)
 (gimp-context-set-brush "2. Hardness 075")(gimp-context-set-brush-size (* 1.5 (max w h)))
 (gimp-clone clean ref CLONE-IMAGE sx sy 2(vector dx dy))(gimp-selection-none im))
(define (mark im file name w h x y)
 (let((l(car(gimp-file-load-layer RUN-NONINTERACTIVE im file))))
 (gimp-image-insert-layer im l 0 0)(gimp-item-set-name l name)(gimp-layer-scale l w h FALSE)(gimp-layer-set-offsets l x y)
 (gimp-levels l HISTOGRAM-VALUE 0 255 1 0 230) l))
(define (save im n)
 (let((l(car(gimp-image-get-active-layer im)))(f 0))
  (gimp-xcf-save RUN-NONINTERACTIVE im l (path(string-append n "-native-master.xcf")) (path(string-append n "-native-master.xcf")))
  (gimp-image-scale im 1920 1081)(gimp-image-resize im 1920 1080 0 0)
  (gimp-xcf-save RUN-NONINTERACTIVE im l (path(string-append n "-master.xcf")) (path(string-append n "-master.xcf")))
  (set! f(car(gimp-image-merge-visible-layers im CLIP-TO-IMAGE)))
  (file-png-save RUN-NONINTERACTIVE im f (path(string-append n "-candidate.png")) (path(string-append n "-candidate.png")) 0 9 0 0 0 0 0)
  (gimp-image-delete im)))
(gimp-context-set-interpolation INTERPOLATION-NOHALO)

(let* ((im(load-image "s018-cats-native-master.xcf")))
 (component im "s018-cats-far-head-grip-donor.png" "Visible far head bearing arm, wrist, hand and continuous pole end" 235 290 545 215
 (list(vector 600 346 612 349 623 372 635 390 640 410 639 429 641 441 625 447 605 440 595 431 594 413 596 392 591 371)))
 (save im "s018-cats"))
(let* ((im(load-image "s021-serat-native-master.xcf"))(layers(cadr(gimp-image-get-layers im)))(clean 0)(ref 0)(fix 0))
 (let loop ((i 0))
  (if(< i (vector-length layers))
   (begin (if(string=? (car(gimp-item-get-name(vector-ref layers i))) "Local cloth repair and human husband horn removal") (set! clean(vector-ref layers i))) (loop(+ i 1)))))
 (gimp-image-select-rectangle im CHANNEL-OP-REPLACE 1530 180 130 140)(gimp-edit-clear clean)(gimp-selection-none im)
 (set! ref(car(gimp-layer-new-from-visible im im "Temporary source for accurate husband hair")))(gimp-image-insert-layer im ref 0 0)(gimp-item-set-visible ref FALSE)
 (set! fix(new-clean im "Human husband - erase actual upper horns, keep natural face and hair"))
 (gimp-image-select-polygon im CHANNEL-OP-REPLACE 22(vector 1577 215 1583 218 1576 229 1572 240 1579 247 1576 254 1567 251 1563 243 1565 233 1570 225 1574 220))
 (gimp-selection-feather im 0.5)(gimp-context-set-brush-size 50)(gimp-clone fix ref CLONE-IMAGE 1544 232 2(vector 1573 233))(gimp-selection-none im)
 (gimp-image-select-polygon im CHANNEL-OP-REPLACE 24(vector 1606 210 1613 215 1618 224 1620 232 1617 239 1609 246 1599 249 1594 246 1599 238 1607 232 1608 225 1602 216))
 (gimp-selection-feather im 0.5)(gimp-clone fix ref CLONE-IMAGE 1640 214 2(vector 1608 228))(gimp-selection-none im)
 ; hair-colored roots, exact face pixels remain from the foundation
 (clone-disc im fix ref 1590 244 1577 249 10 10)
 (clone-disc im fix ref 1592 234 1601 242 12 11)
 (gimp-image-remove-layer im ref)
 (save im "s021-serat"))
(gimp-quit 0)
