(let* ((img (car (gimp-file-load RUN-NONINTERACTIVE "visual-novel/art/scene-studies/s054-throne-hall/hall-local-master.xcf" "master")))
       (src (car (gimp-layer-new-from-visible img img "Hidden pre-butt composite for exact background samples")))
       (clean (car (gimp-layer-new img 1672 941 RGBA-IMAGE "Remove only excess rear shaft; nearby same wall samples" 100 NORMAL-MODE)))
       (cap (car (gimp-file-load-layer RUN-NONINTERACTIVE img "visual-novel/art/scene-studies/s054-throne-hall/framing-border-component.png"))))
 (gimp-image-insert-layer img src 0 0)
 (gimp-item-set-visible src FALSE)
 (gimp-image-insert-layer img clean 0 0)
 (gimp-drawable-fill clean TRANSPARENT-FILL)
 (gimp-context-set-brush "2. Hardness 075")
 (gimp-context-set-brush-size 22)
 (gimp-image-select-polygon img CHANNEL-OP-REPLACE 8 (vector 1603 252 1672 234 1672 263 1603 282))
 (gimp-selection-feather img 1)
 (for-each (lambda (pt) (gimp-clone clean src CLONE-IMAGE (car pt) (+ (cadr pt) 23) 2 (vector (car pt) (cadr pt)))) '((1606 265) (1618 262) (1630 259) (1642 256) (1654 253) (1666 250) (1674 248)))
 (gimp-selection-none img)
 (gimp-image-insert-layer img cap 0 0)
 (gimp-layer-resize cap 29 32 -1558 -274)
 (gimp-layer-set-offsets cap 1592 249)
 (gimp-item-set-name cap "Generated plain spear butt cap only; shaft axis and grips unchanged")
 (gimp-image-select-polygon img CHANNEL-OP-REPLACE 24 (vector 1592 260 1598 259 1599 256 1605 251 1610 253 1616 257 1618 262 1616 269 1611 274 1601 272 1599 269 1592 271))
 (gimp-selection-feather img 0.7)
 (let ((mask (car (gimp-layer-create-mask cap ADD-BLACK-MASK))))
  (gimp-layer-add-mask cap mask)
  (gimp-context-set-foreground '(255 255 255))
  (gimp-edit-fill mask FOREGROUND-FILL))
 (gimp-selection-none img)
 (gimp-xcf-save RUN-NONINTERACTIVE img cap "visual-novel/art/scene-studies/s054-throne-hall/hall-local-master.xcf" "master")
 (let* ((copy (car (gimp-image-duplicate img))) (flat (car (gimp-image-merge-visible-layers copy CLIP-TO-IMAGE))))
  (file-png-save RUN-NONINTERACTIVE copy flat "/tmp/s054-final-native.png" "native" 0 9 0 0 0 0 0)
  (gimp-image-delete copy))
 (gimp-context-set-interpolation INTERPOLATION-NOHALO)
 (gimp-image-scale img 1920 1080)
 (gimp-xcf-save RUN-NONINTERACTIVE img cap "visual-novel/art/scene-studies/s054-throne-hall/hall-delivery-master.xcf" "master")
 (let ((flat (car (gimp-image-merge-visible-layers img CLIP-TO-IMAGE))))
  (file-png-save RUN-NONINTERACTIVE img flat "/tmp/s054-final-review.png" "review" 0 9 0 0 0 0 0))
 (gimp-image-delete img))
