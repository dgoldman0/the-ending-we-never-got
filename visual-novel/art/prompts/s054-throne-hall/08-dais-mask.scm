(let* ((img (car (gimp-file-load RUN-NONINTERACTIVE "visual-novel/art/scene-studies/s054-throne-hall/hall-local-master.xcf" "master")))
       (dais (car (gimp-file-load-layer RUN-NONINTERACTIVE img "visual-novel/art/scene-studies/s054-throne-hall/low-dais-component.png"))))
 (let ((old (vector-ref (cadr (gimp-image-get-layers img)) 0)))
  (if (string=? (car (gimp-item-get-name old)) "Low three-riser dais and lowered throne only; original pillar/shaft/body excluded")
   (gimp-image-remove-layer img old)))
 (gimp-image-insert-layer img dais 0 0)
 (gimp-item-set-name dais "Low three-riser dais and lowered throne only; original pillar/shaft/body excluded")
 (gimp-image-select-rectangle img CHANNEL-OP-REPLACE 525 175 690 420)
 (gimp-selection-feather img 4)
 (gimp-image-select-polygon img CHANNEL-OP-SUBTRACT 40 (vector 650 170 777 170 779 405 780 414 787 418 788 426 794 430 797 440 801 442 799 559 792 565 610 565 610 480 615 480 615 462 625 453 632 443 645 429 645 418 650 408))
 (gimp-image-select-polygon img CHANNEL-OP-SUBTRACT 42 (vector 1182 175 1250 175 1250 612 1154 612 1154 577 1163 547 1170 505 1178 465 1192 422 1193 402 1167 393 1148 406 1124 407 1110 395 1108 379 1121 363 1134 357 1150 338 1153 305 1164 245 1182 200))
 (gimp-image-select-polygon img CHANNEL-OP-SUBTRACT 20 (vector 686 489 815 438 838 446 847 439 1223 348 1223 362 850 458 839 456 822 468 700 491))
 (let ((mask (car (gimp-layer-create-mask dais ADD-BLACK-MASK))))
  (gimp-layer-add-mask dais mask)
  (gimp-context-set-foreground '(255 255 255))
  (gimp-edit-fill mask FOREGROUND-FILL))
 (gimp-selection-none img)
 (gimp-xcf-save RUN-NONINTERACTIVE img dais "visual-novel/art/scene-studies/s054-throne-hall/hall-local-master.xcf" "master")
 (let* ((copy (car (gimp-image-duplicate img))) (flat (car (gimp-image-merge-visible-layers copy CLIP-TO-IMAGE))))
  (file-png-save RUN-NONINTERACTIVE copy flat "/tmp/s054-low-dais-composite.png" "review" 0 9 0 0 0 0 0)
  (gimp-image-delete copy))
 (gimp-image-delete img))
