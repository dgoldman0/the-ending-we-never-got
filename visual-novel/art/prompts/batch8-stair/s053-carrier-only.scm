(load "visual-novel/art/prompts/batch8-stair/local-compose.scm")
(let* ((source "visual-novel/art/scene-studies/batch8-stair/source-before/s053-bend.png") (img (car (gimp-file-load RUN-NONINTERACTIVE source source))) (layer 0))
(gimp-item-set-name (car (gimp-image-get-active-layer img)) "Current runtime source, every existing local repair preserved")
(set! layer (car (gimp-file-load-layer RUN-NONINTERACTIVE img source)))
(gimp-image-insert-layer img layer 0 0)
(gimp-item-set-name layer "Unnamed carrier dark hair: red/yellow hues only; blue backdrop protected")
(gimp-hue-saturation layer RED-HUES 0 -23 -78)
(gimp-hue-saturation layer YELLOW-HUES 0 -23 -78)
(mask-poly img layer #(1464 54 1468 41 1480 30 1495 25 1502 29 1518 29 1527 35 1533 42 1542 56 1539 64 1534 66 1530 64 1528 58 1526 58 1524 66 1524 72 1518 76 1508 76 1499 79 1481 78 1470 74 1465 64) 0.8)
; Preserve the original ear and neck where hair hue overlaps their warm colour.
(set! layer (car (gimp-file-load-layer RUN-NONINTERACTIVE img source)))
(gimp-image-insert-layer img layer 0 0)
(gimp-item-set-name layer "Original ear and nape, exact registration")
(mask-poly img layer #(1521 58 1525 58 1526 65 1528 74 1534 80 1533 89 1523 87 1516 81 1516 71 1519 64) 0.45)
(export-master img "visual-novel/art/scene-studies/batch8-stair/s053-carrier-only"))
(gimp-quit 0)
