(define d "visual-novel/art/scene-studies/batch7-cats-minor/s018-cats/")
(define (poly im points)
 (gimp-image-select-polygon im CHANNEL-OP-REPLACE (length points) (list->vector points)))
(let* ((im (car (gimp-file-load RUN-NONINTERACTIVE (string-append d "action-donor.png") "base"))) (base (car (gimp-image-get-active-layer im))))
 (gimp-item-set-name base "Corrected gorge, downhill route, obstruction and bearer interception")
 (let* ((ly (car (gimp-file-load-layer RUN-NONINTERACTIVE im (string-append d "tessa-head-panel-donor.png")))))
  (gimp-image-insert-layer im ly 0 0)
  (gimp-layer-scale ly 468 387 FALSE) (gimp-layer-set-offsets ly 140 189)
  (gimp-item-set-name ly "Young Tessa face, natural freckles and early botanical panels — local mask")
  (let* ((mask (car (gimp-layer-create-mask ly ADD-BLACK-MASK))))
   (gimp-layer-add-mask ly mask)
   (poly im '(208 244 230 229 267 230 298 242 313 263 313 293 300 315 283 337 308 338 328 391 340 439 352 486 360 527 329 539 286 538 246 533 206 519 188 512 219 464 232 426 222 361 195 344 193 315 201 283))
   (gimp-selection-feather im 3)
   (gimp-context-set-foreground '(255 255 255)) (gimp-edit-fill mask FOREGROUND-FILL)
   (gimp-selection-none im)))
 (let* ((ly (car (gimp-file-load-layer RUN-NONINTERACTIVE im (string-append d "mara-ground-donor.png")))))
  (gimp-image-insert-layer im ly 0 0)
  (gimp-layer-scale ly 553 641 FALSE) (gimp-layer-set-offsets ly 1119 300)
  (gimp-item-set-name ly "Continuous trail under Mara boots; natural foreground occlusion")
  (let* ((mask (car (gimp-layer-create-mask ly ADD-BLACK-MASK))))
   (gimp-layer-add-mask ly mask)
   (poly im '(1170 635 1270 632 1330 637 1400 656 1470 669 1550 656 1650 638 1675 635 1675 945 1160 945 1155 835 1178 779 1185 717))
   (gimp-selection-feather im 6)
   (gimp-edit-fill mask WHITE-FILL) (gimp-selection-none im)))
 (gimp-xcf-save RUN-NONINTERACTIVE im (car (gimp-image-get-active-layer im)) (string-append d "native-master.xcf") "master.xcf")
 (let* ((copy (car (gimp-image-duplicate im))))
  (gimp-image-scale copy 1920 1081) (gimp-image-crop copy 1920 1080 0 0)
  (gimp-xcf-save RUN-NONINTERACTIVE copy (car (gimp-image-get-active-layer copy)) (string-append d "repair-master.xcf") "master.xcf")
  (let* ((merged (car (gimp-image-merge-visible-layers copy CLIP-TO-IMAGE))))
   (file-png-save RUN-NONINTERACTIVE copy merged (string-append d "candidate.png") "candidate.png" 0 9 0 0 0 0 0))
  (gimp-image-delete copy))
 (gimp-image-delete im))
(gimp-quit 0)
